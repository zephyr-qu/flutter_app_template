# 示例 / 默认环境配置（提交入库）。
# 默认就用它：flutter run --dart-define-from-file=.env.example（或 just run）
# 要个性化：复制为 .env.development（已被 .gitignore 忽略），再
#   flutter run --dart-define-from-file=.env.development
# 只能放非密钥配置；密钥走 --dart-define。
#
# 这些值以**编译期常量**注入（bootstrap.dart 的 String.fromEnvironment），
# 不走 .env 文件加载，也不进 pubspec 的 assets。

# 后端 API 基础地址
BASE_URL=http://localhost:8080/api

# true = 不发真实请求，返回内置 Mock（无需后端即可跑通集成测试）
USE_MOCK=true
