# ════════════════════════════════════════════
# 环境变量模板
# ════════════════════════════════════════════
# 将本文件复制为 .env.development 或 .env.production
# 通过 --dart-define=env=xxx 选择加载哪个文件：
#
#   flutter run --dart-define=env=development
#   flutter run --dart-define=env=production
#
# 两点容易误判：
#   1. 本文件只是模板，运行时**不会**被加载 —— 加载的永远是 .env.<环境名>
#      （bootstrap.dart 的 _envFileName）。
#   2. .env / .env.development / .env.production 会被提交进 git，并作为 asset
#      打进产物（pubspec.yaml 的 assets），所以这里**只能放非密钥配置**；
#      密钥走 --dart-define，不要写进来。
#
# ════════════════════════════════════════════

# ── API ───
# 后端 API 基础地址
# 类型: string
# 默认值: https://api.example.com
# 在 bootstrap.dart 中验证，release 模式下缺失会抛异常
# 被 lib/core/config/network_config.dart 使用
BASE_URL=https://api.example.com

# ── Mock ───
# 本地 Mock 开关：true 时不发起真实 HTTP 请求，直接返回内置 mock 数据
# 类型: bool（"true" / "false"）
# 默认值: false（未设置时按 false 处理）
# 被 lib/core/config/network_config.dart 使用
USE_MOCK=false
