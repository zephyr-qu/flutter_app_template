#!/bin/sh
# 门禁：一条命令 `just verify`（5 项，首个失败即停）。
# 清单见 cross-cutting.md；单项重跑直接手跑对应命令。
#
# 生成物不入库，但 analyze 需要它们在磁盘上：stash --keep-index 可能按 index
# 清掉「已暂存删除」的生成物，故 stash 前后备份/恢复。
# 备份目录挂在**真实 git 目录**下：linked worktree 里 `.git` 是文件而不是目录，
# 写 `.git/xxx` 会失败（mkdir 报错被 `|| return 0` 吞掉 → 备份静默失效）。

echo "🔍 Running pre-commit checks..."

GEN_BACKUP="$(git rev-parse --git-dir)/pre-commit-gen-backup"

backup_generated() {
    rm -rf "$GEN_BACKUP"
    mkdir -p "$GEN_BACKUP" || return 0
    git ls-tree -r HEAD --name-only | grep -E '\.(g|freezed|gr|config|gen)\.dart$' |
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            mkdir -p "$GEN_BACKUP/$(dirname "$f")"
            cp "$f" "$GEN_BACKUP/$f"
        done
}

restore_generated() {
    [ -d "$GEN_BACKUP" ] || return 0
    find "$GEN_BACKUP" -type f 2>/dev/null |
        while IFS= read -r src; do
            rel="${src#"$GEN_BACKUP"/}"
            [ -f "$rel" ] && continue
            mkdir -p "$(dirname "$rel")"
            cp "$src" "$rel"
        done
}

remove_generated_not_in_index() {
    [ -d "$GEN_BACKUP" ] || return 0
    find "$GEN_BACKUP" -type f 2>/dev/null |
        while IFS= read -r src; do
            rel="${src#"$GEN_BACKUP"/}"
            [ -f "$rel" ] || continue
            if ! git ls-files --error-unmatch -- "$rel" >/dev/null 2>&1; then
                rm -f "$rel"
            fi
        done
}

backup_generated

# Stash any unstaged changes so we only check what would be committed
STASH_NAME="pre-commit-$(date +%s)"
stashed=0
if git stash push -q --keep-index --include-untracked --message "$STASH_NAME" 2>/dev/null; then
    stashed=1
fi

restore_generated

just verify
VERIFY_EXIT=$?

remove_generated_not_in_index

POP_FAILED=0
if [ "$stashed" -eq 1 ]; then
    if ! git stash pop -q 2>/dev/null; then
        POP_FAILED=1
    fi
fi

restore_generated
rm -rf "$GEN_BACKUP"

# pop 失败必须拦下来：此时工作区缺少被 stash 的改动，若照常提交，那份改动就只留在
# stash 里没人管（2026-09-24 因此丢过 7 个未跟踪文件）。门禁通过也不放行。
if [ "$POP_FAILED" -eq 1 ]; then
    echo ""
    echo "❌ 中止提交：git stash pop 失败"
    echo "   未暂存的改动仍留在 stash，没有回到工作区。"
    echo "   stash 名：$STASH_NAME（git stash list 可查）"
    echo "   处理：git status 看冲突，再手工 git stash pop / git stash apply。"
    if [ $VERIFY_EXIT -ne 0 ]; then
        echo "   注意：门禁同时也失败了（见上面输出）。"
    fi
    exit 1
fi

if [ $VERIFY_EXIT -ne 0 ]; then
    echo ""
    echo "❌ Pre-commit checks failed!（上面最后一步就是失败的那道门禁）"
    echo "To skip (emergency only): git commit --no-verify"
    exit 1
fi

echo ""
echo "✅ All pre-commit checks passed!"
exit 0
